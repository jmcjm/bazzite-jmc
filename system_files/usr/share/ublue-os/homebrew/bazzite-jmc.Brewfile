# Tools that stay in Homebrew - not packaged in Fedora or updated too slowly
# there. Installed on demand with: ujust install-brews
# Sunshine is intentionally absent - it is managed by `ujust setup-sunshine`.
tap "f/mcptools"

brew "bitwarden-cli"
brew "cosign"
brew "gcc"
brew "go"
brew "herdr"
brew "nmap"
brew "opencode"
brew "f/mcptools/mcp"
